# 공개 사이트 기준 URL. 끝에 슬래시를 붙이지 않습니다.
SITE_URL=http://localhost:3000

# 로컬 샘플은 memory, Supabase 연결 시 supabase로 바꿉니다.
DATASTORE_PROVIDER=memory

# Supabase 공개 조회 연결. Publishable Key는 공개용이지만 소스에 하드코딩하지 않습니다.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# 자동 발행·실행 저널 쓰기에만 사용하는 서버 비밀입니다.
# 브라우저 변수(NEXT_PUBLIC_*)로 만들거나 저장소에 커밋하지 않습니다.
# SUPABASE_SECRET_KEY=sb_secret_your-server-key

# 보존 중인 Cloud Firestore 어댑터를 다시 시험할 때만 사용합니다.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIRESTORE_DATABASE_ID=(default)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# 로컬 Firebase Emulator Suite를 사용할 때만 설정합니다.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Gemini 기사 작성·의미 검증 서버 키입니다. 브라우저 변수로 만들지 않습니다.
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-key
# LLM_ENABLED=false
# LLM_PROVIDER=gemini
# GEMINI_FREE_TIER_DATA_USE_ACKNOWLEDGED=false

# disabled가 기본입니다. 운영 Cron을 명시적으로 켤 때만 live로 설정합니다.
AUTOMATION_MODE=disabled
# CRON_SECRET=

# 검토된 RSS를 source ID 하나로 실제 1회 확인하는 운영 스모크입니다.
# 24시간 예약을 소비하므로 날짜와 source ID를 명령 환경에 일회성으로만 전달합니다.
# ALLOW_RSS_SOURCE_SMOKE=true
# RSS_SOURCE_SMOKE_CONFIRM_DATE=YYYY-MM-DD
# RSS_SOURCE_SMOKE_ID=ec-digital-strategy

# 아래 값은 실제 공개 테스트 게시물 1건을 만들 때만 명령 환경에 일회성으로
# 전달합니다. .env.local에 상시 저장하지 않습니다.
# ALLOW_TEST_PUBLICATION=true
# TEST_PUBLICATION_CONFIRM_DATE=YYYY-MM-DD

# Supabase+공식 RSS dry-run은 해당 날짜의 실행 슬롯과 출처 호출 간격을
# 소비하므로 preview 프로젝트에서만 일회성으로 사용합니다.
# ALLOW_SUPABASE_DRY_RUN=true
# SUPABASE_DRY_RUN_CONFIRM_DATE=YYYY-MM-DD
# ALLOW_PRODUCTION_SUPABASE_DRY_RUN=false
